theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 16
text = "A / D  ou  Setas ........ correr
ESPAÇO ..................... pular
SHIFT ........................ dash  (desbloqueado na fase 2)
ESPAÇO no ar .............. pulo duplo  (fase 3)
segurar ESPAÇO caindo .. planar  (fase 4)
ESC ........................... pausar
R ............................... recomeçar a fase

Você é imortal: espinhos, lasers, carros e trens
só te empurram. Só o toque do CARAMUJO acaba
com você. Ele rasteja por chão, paredes e tetos."
autowrap_mode = 2

